generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Libro {
  id     Int    @id @default(autoincrement())
  titulo String
  autor  String
  imagen String
}

model Autor {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}